<Window x:Class="ISIP523_Mulkamonov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        Icon="/res/Логотип.png"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <Button x:Name="BtnBack" Content="Назад" Width="100" HorizontalAlignment="Left" Click="BtnBack_Click" Visibility="Hidden"/>

        <Button x:Name="BtnTheme" Content="Сменить тему 🌙" Width="150" HorizontalAlignment="Right" Click="BtnTheme_Click" Background="#233E76"/>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>

        <TextBlock x:Name="DateTimeNow" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15"/>
    </Grid>
</Window>