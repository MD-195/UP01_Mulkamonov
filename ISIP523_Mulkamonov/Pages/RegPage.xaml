<Page x:Class="ISIP523_Mulkamonov.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">

    <Grid Background="{DynamicResource WindowBg}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
        <Border Background="{DynamicResource WindowBg}"  Padding="20" Margin="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Логин:" Margin="0,5"/>
                <TextBox x:Name="TxtLogin" Height="30" ToolTip="Придумайте логин"/>

                <TextBlock Text="Пароль (от 6 символов):" Margin="0,15,0,5"/>
                <PasswordBox x:Name="TxtPassword" Height="30"/>

                <TextBlock Text="Подтвердите пароль:" Margin="0,15,0,5"/>
                <PasswordBox x:Name="TxtConfirmPassword" Height="30"/>

                <TextBlock Text="ФИО:" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtFIO" Height="30" ToolTip="Введите ваше полное имя"/>

                <TextBlock Text="Выберите вашу роль:" Margin="0,15,0,5"/>
                <ComboBox x:Name="ComboRole" Height="30" SelectedValuePath="ID" DisplayMemberPath="Name"/>

                <Button Content="Зарегистрироваться" Click="BtnRegister_Click" Margin="0,20,0,0"/>
                <Button Content="Назад к авторизации" Click="BtnBack_Click" Background="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>