<Page x:Class="ISIP523_Mulkamonov.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчеты и Диаграммы">

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBg}" Padding="10" Margin="10" CornerRadius="5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Владелец:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="ComboOwner" Width="200" SelectedValuePath="ID" DisplayMemberPath="FIO" SelectionChanged="ComboOwner_SelectionChanged" Margin="5"/>

                <Button Content="Экспорт в Word" Click="BtnExportWord_Click" Background="#233E76" Margin="20,5,5,5"/>
                <Button Content="Экспорт в Excel" Click="BtnExportExcel_Click" Background="#0198AF" Margin="5"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" Margin="10" Padding="10" CornerRadius="5">
            <WindowsFormsHost x:Name="HostPanel"/>
        </Border>
    </Grid>
</Page>