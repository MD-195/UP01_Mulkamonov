<Page x:Class="ISIP523_Mulkamonov.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель Администратора">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DGridRealEstate" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerMonth}" Width="100"/>
                <DataGridTextColumn Header="Владелец" Binding="{Binding User.FIO}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отчеты и Графики" Click="BtnReports_Click" Background="#233E76"/>
            <Button Content="Договоры аренды" Click="BtnRentals_Click" Background="{DynamicResource PrimaryDarkBlue}"/>
            <Button Content="Добавить объект" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Click="BtnEdit_Click"/>
            <Button Content="Удалить выбранное" Click="BtnDelete_Click" Background="#DD4842"/>
        </StackPanel>
    </Grid>
</Page>