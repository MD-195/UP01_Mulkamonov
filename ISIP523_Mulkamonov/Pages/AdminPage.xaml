<Page x:Class="ISIP523_Mulkamonov.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель Администратора">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DGridRealEstate" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerMonth}" Width="100"/>
                <DataGridTextColumn Header="Владелец" Binding="{Binding User.FIO}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

            <Button Click="BtnReports_Click" Background="#193057">
                <TextBlock Text="Отчеты и Графики" Foreground="White"/>
            </Button>
            <Button Click="BtnRentals_Click" Background="#193057">
                <TextBlock Text="Договоры аренды" Foreground="White"/>
            </Button>
            <Button Click="BtnAdd_Click" Background="#0198AF">
                <TextBlock Text="Добавить объект" Foreground="White"/>
            </Button>
            <Button Click="BtnEdit_Click" Background="#0198AF">
                <TextBlock Text="Редактировать" Foreground="White"/>
            </Button>
            <Button Click="BtnDelete_Click" Background="#DD4842">
                <TextBlock Text="Удалить выбранное" Foreground="White"/>
            </Button>

        </StackPanel>
    </Grid>
</Page>