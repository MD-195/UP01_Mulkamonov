<Page x:Class="ISIP523_Mulkamonov.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог недвижимости">

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtSearch" Width="150" TextChanged="Filter_Changed"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="ComboSort" Width="150" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Сначала дешевые"/>
                <ComboBoxItem Content="Сначала дорогие"/>
            </ComboBox>

            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="ComboCategory" Width="150" SelectionChanged="Filter_Changed"/>
        </WrapPanel>

        <ListView x:Name="ListRealEstate" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource PrimaryCyan}" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="250" Background="{DynamicResource CardBg}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Category.Name}" FontStyle="Italic" Foreground="{DynamicResource PrimaryCyan}" HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding PricePerMonth, StringFormat='Цена: {0:N2} руб./мес.'}" Margin="0,10,0,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Area, StringFormat='Площадь: {0} кв.м.'}"/>
                            <TextBlock Text="{Binding Address}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>